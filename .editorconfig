# Editor settings for vkmin. See docs/style.md for the conventions these encode.
# These are the parts of the style that are mechanical and unambiguous; the
# judgement-dependent parts are in the document, not here.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Tabs are part of the syntax here, not a style choice.
[{Makefile,Makefile.*}]
indent_style = tab

[*.{c,h}]
indent_style = space
indent_size = 4
# Advisory, not a hard limit. See "Line width" in docs/style.md.
max_line_length = 100

[*.{glsl,vert,frag,comp}]
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 100

[*.{yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{cmd,ps1}]
end_of_line = crlf

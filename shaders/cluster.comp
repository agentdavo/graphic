#version 450
// cluster.comp -- assigns lights to froxels. One thread per cluster: build the
// cluster's view-space AABB, test every local light's bounding sphere against
// it, write a fixed-capacity list. No atomics, no dependence on order, so the
// result is deterministic.
#include "common.glsl"
layout(local_size_x = VKMIN_CLUSTER_GROUP) in;

vec3 unproject_at_depth(Frame frame, vec2 ndc, float depth) {
    // A point at NDC (x, y) on the near plane, then scaled out along its ray.
    mat4 inv_proj = inverse(frame.proj);
    vec4 p = inv_proj * vec4(ndc, 0.0, 1.0);
    p /= p.w;
    // Orthographic (w row 0,0,0,1): the near point slides straight back.
    if (frame.proj[3][3] == 1.0 && frame.proj[2][3] == 0.0) return vec3(p.xy, -depth);
    return p.xyz * (depth / -p.z);
}

void main() {
    Frame frame = FrameRef(push.frame).frame;
    uint index = gl_GlobalInvocationID.x;
    if (index >= VKMIN_CLUSTER_COUNT) return;
    uvec3 c = uvec3(index % VKMIN_CLUSTER_X, (index / VKMIN_CLUSTER_X) % VKMIN_CLUSTER_Y,
                    index / (VKMIN_CLUSTER_X * VKMIN_CLUSTER_Y));

    float near = frame.cluster_params.z, far = frame.cluster_params.w;
    float z0 = near * pow(far / near, float(c.z) / float(VKMIN_CLUSTER_Z));
    float z1 = near * pow(far / near, float(c.z + 1u) / float(VKMIN_CLUSTER_Z));
    vec2 ndc_min = vec2(c.xy) / vec2(VKMIN_CLUSTER_X, VKMIN_CLUSTER_Y) * 2.0 - 1.0;
    vec2 ndc_max = vec2(c.xy + 1u) / vec2(VKMIN_CLUSTER_X, VKMIN_CLUSTER_Y) * 2.0 - 1.0;

    vec3 bmin = vec3(1e30), bmax = vec3(-1e30);
    for (int k = 0; k < 8; ++k) {
        vec2 ndc = vec2((k & 1) != 0 ? ndc_max.x : ndc_min.x, (k & 2) != 0 ? ndc_max.y : ndc_min.y);
        vec3 p = unproject_at_depth(frame, ndc, (k & 4) != 0 ? z1 : z0);
        bmin = min(bmin, p);
        bmax = max(bmax, p);
    }

    ClusterRef lists = ClusterRef(frame.cluster_lights);
    LightRef lights = LightRef(frame.lights);
    uint base = index * VKMIN_CLUSTER_STRIDE;
    uint count = 0u;
    for (uint l = 0u; l < frame.light_count && count < VKMIN_CLUSTER_MAX_LIGHTS; ++l) {
        Light light = lights.l[l];
        if (light.type == VKMIN_LIGHT_DIRECTIONAL) continue;
        vec3 pv = (frame.view * vec4(light.pos_radius.xyz, 1.0)).xyz;
        vec3 q = clamp(pv, bmin, bmax) - pv;
        if (dot(q, q) <= light.pos_radius.w * light.pos_radius.w) {
            lists.lights[base + 1u + count] = l;
            ++count;
        }
    }
    lists.lights[base] = count;
}

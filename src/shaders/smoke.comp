#version 450
// smoke.comp -- writes a textured triangle's vertices to a buffer by device
// address. Exists to prove compute -> draw hand-off through the layer: this,
// smoke.vert and smoke.frag are one three-stage smoke test, and only make
// sense together. No C in the repository names their _spv symbols at present,
// so nothing currently runs the test; they are still compiled and embedded.
#include "common.glsl"
layout(local_size_x = 64) in;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= 3u) return;
    VertexRef verts = VertexRef(push.aux);
    const vec2 pos[3] = vec2[3](vec2(-0.8, 0.8), vec2(0.8, 0.8), vec2(0.0, -0.8));
    const vec2 uv[3] = vec2[3](vec2(0.0, 1.0), vec2(1.0, 1.0), vec2(0.5, 0.0));
    Vertex v;
    v.px = pos[i].x;
    v.py = pos[i].y;
    v.pz = 0.5;
    v.normal = 0u;
    v.tangent = 0u;
    v.uv = packHalf2x16(uv[i]);
    verts.v[i] = v;
}

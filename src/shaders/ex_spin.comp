#version 450
// 05: a compute shader writes the triangle's vertices as a function of the
// frame index. The draw that follows pulls them by address.
#define VKMIN_OWN_PUSH
#include "common.glsl"
layout(buffer_reference, scalar) buffer ExVertexRef { ExVertex v[]; };
layout(push_constant, scalar) uniform ExBlock { ExPush ex; } ;
layout(local_size_x = 64) in;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= 3u) return;
    float a = ex.time * 1.5 + float(i) * 2.0943951;
    ExVertex v;
    v.px = 0.6 * cos(a); v.py = 0.6 * sin(a); v.pz = 0.0;
    v.color = i == 0u ? 0xff4040ffu : i == 1u ? 0xff40ff40u : 0xffff6040u;
    v.u = 0.0; v.v = 0.0; v.pad0 = 0.0; v.pad1 = 0.0;
    ExVertexRef(ex.vertices).v[i] = v;
}

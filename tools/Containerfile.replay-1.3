# A real Vulkan 1.3 driver, with the current loader and validation layer.
FROM docker.io/library/ubuntu:24.04 AS driver
RUN apt-get update -qq && apt-get install -y --no-install-recommends mesa-vulkan-drivers=24.0.5-1ubuntu1 && \
    mkdir /driver && cd /usr/lib/x86_64-linux-gnu && \
    cp -L libvulkan_lvp.so libLLVM-17.so.1 libxml2.so.2 libicuuc.so.74 libicudata.so.74 /driver/ && \
    sed 's|/usr/lib/x86_64-linux-gnu/libvulkan_lvp.so|/opt/vulkan-1.3/libvulkan_lvp.so|' /usr/share/vulkan/icd.d/lvp_icd.x86_64.json > /driver/icd.json
FROM localhost/vkmin-replay:9
COPY --from=driver /driver /opt/vulkan-1.3
ENV LD_LIBRARY_PATH=/opt/vulkan-1.3 VK_DRIVER_FILES=/opt/vulkan-1.3/icd.json
